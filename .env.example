# RaktSetu Environment Variables (.env.example)
# Note: Never commit secrets to version control. Copy this file to .env.local

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Free Tier PostgreSQL + PostGIS)
# Used for blood_requests, blood_banks, donors, and donor_requests
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram Bot API (100% Free - Used for donor availability requests)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=RaktSetuBot
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# Cloudflare Turnstile (Free CAPTCHA for spam prevention on requests)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Future WhatsApp Cloud API (Optional paid upgrade stub, kept disabled for MVP)
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
